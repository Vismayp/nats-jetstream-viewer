# Generate: openssl rand -base64 32
NJV_MASTER_KEY=

# Use a unique password of at least 12 characters.
NJV_ADMIN_PASSWORD=

# Generate: openssl rand -base64 48
NJV_SESSION_SECRET=

# Optional: enables the bearer-protected read-only HTTP gateway endpoints.
# Generate with: openssl rand -base64 32
NJV_GATEWAY_TOKEN=

PORT=3000
