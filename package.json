{
  "name": "nats-jetstream-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "vite",
    "dev:full": "concurrently -n api,web -c blue,green \"tsx watch src/server.ts\" \"vite\"",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist-server/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "npm run typecheck && npm test && npm run test:integration && npm run build",
    "lint": "eslint ."
  },
  "dependencies": {
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/transport-node": "^3.4.0",
    "@vitejs/plugin-react": "^5.0.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "quickjs-emscripten": "^0.31.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.3",
    "zod": "^4.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.1",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "jsdom": "^26.1.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  },
  "optionalDependencies": {
    "@eplightning/nats-server-darwin-arm64": "^2.14.0",
    "@eplightning/nats-server-darwin-x64": "^2.14.0",
    "@eplightning/nats-server-linux-arm64": "^2.14.0",
    "@eplightning/nats-server-linux-x64": "^2.14.0",
    "@eplightning/nats-server-win32-x64": "^2.14.0"
  }
}
